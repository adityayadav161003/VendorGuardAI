# --- Database ---
DATABASE_URL=sqlite:///./vendorguard.db

# --- Security (REQUIRED for any shared deployment) ---
# JWT signing secret. If unset, a random per-process secret is generated and
# all sessions invalidate on every server restart.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bootstrap admin account (seeded once at first startup; change the password!)
ADMIN_EMAIL=admin@vendorguard.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# CORS allow-list (comma-separated origins of the web UI)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
